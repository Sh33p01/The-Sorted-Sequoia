---
import Logo from './Logo.astro';
import { site, nav, services } from '../data/site.js';

const year = new Date().getFullYear();
const socialIcons: Record<string, string> = {
  facebook:
    '<circle cx="12" cy="12" r="9.2" fill="none" stroke="currentColor" stroke-width="1.5"/>' +
    '<path d="M13.55 8.7h1.65V6.42a21 21 0 0 0-2.03-.1c-2.01 0-3.39 1.23-3.39 3.48v1.94H8.05v2.55h1.73v6.19h2.59v-6.19h1.99l.33-2.55h-2.32V10.1c0-.74.25-1.4 1.18-1.4z" fill="currentColor"/>',
  instagram:
    '<rect x="3.3" y="3.3" width="17.4" height="17.4" rx="5" fill="none" stroke="currentColor" stroke-width="1.5"/>' +
    '<circle cx="12" cy="12" r="4.05" fill="none" stroke="currentColor" stroke-width="1.5"/>' +
    '<circle cx="16.9" cy="7.1" r="1.15" fill="currentColor"/>',
};

const socials = Object.entries(site.social)
  .filter(([platform, url]) => url && socialIcons[platform])
  .map(([platform, url]) => ({
    platform,
    url,
    label: platform.charAt(0).toUpperCase() + platform.slice(1),
    icon: socialIcons[platform],
  }));
---

<style>
  .footer {
    background-color: var(--evergreen);
    color: var(--linen);
    padding-block-start: var(--space-2xl);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: var(--space-lg) var(--space-md);
    padding-block-end: var(--space-xl);
  }

  .footer__blurb {
    margin-block-start: var(--space-md);
    max-width: 32ch;
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--sage-hint);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-block-end: var(--space-sm);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .footer__list a,
  .footer__address a {
    color: var(--linen);
    font-size: var(--step--1);
    text-decoration: none;
    transition: color var(--duration) var(--ease);
  }

  .footer__list a:hover,
  .footer__address a:hover {
    color: var(--gold-light);
    text-decoration: underline;
  }

  .footer__address {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-style: normal;
    font-size: var(--step--1);
    color: var(--sage-hint);
  }

  .footer__name {
    color: var(--linen);
    font-weight: 600;
  }

  .footer__social {
    display: flex;
    gap: var(--space-xs);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--linen);
    border: 1px solid rgba(244, 241, 235, 0.3);
    border-radius: 50%;
    transition: color var(--duration) var(--ease),
                border-color var(--duration) var(--ease),
                background-color var(--duration) var(--ease);
  }

  .footer__social a:hover,
  .footer__social a:focus-visible {
    color: var(--evergreen);
    background-color: var(--linen);
    border-color: var(--linen);
  }

  .footer__social svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-block: var(--space-md);
    border-block-start: 1px solid rgba(217, 184, 124, 0.28);
  }

  .footer__bottom p {
    font-size: var(--step--1);
    color: var(--sage-hint);
    margin: 0;
  }

  @media (max-width: 56rem) {
    .footer__inner {
      grid-template-columns: 1fr 1fr;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34rem) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <Logo variant="inverse" />
      <p class="footer__blurb">
        Professional decluttering and home organising in {site.area.label}.
        Turning everyday chaos into calm, functional spaces.
      </p>
    </div>

    <nav class="footer__col" aria-label="Footer">
      <h2 class="footer__heading">Explore</h2>
      <ul class="footer__list">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="footer__col">
      <h2 class="footer__heading">Services</h2>
      <ul class="footer__list">
        {services.map((service) => (
          <li><a href={`/services/#${service.id}`}>{service.title}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">Get in touch</h2>
      <address class="footer__address">
        <span class="footer__name">{site.name}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.phone.publish && (
          <a href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
        )}
        <span class="footer__area">{site.area.label}, {site.area.region}</span>
      </address>

      {socials.length > 0 && (
        <ul class="footer__social">
          {socials.map((social) => (
            <li>
              <a href={social.url} rel="noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <Fragment set:html={social.icon} />
                </svg>
                <span class="visually-hidden">
                  {site.name} on {social.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {year} {site.name}. All rights reserved.</p>
    <p class="footer__serving">Proudly serving {site.area.label}.</p>
  </div>
</footer>
