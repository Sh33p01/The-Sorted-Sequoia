---
interface Props {
  variant?: 'default' | 'inverse';
}

const { variant = 'default' } = Astro.props;
---

<style>
  .logo {
    --mark-size: 2.9rem;

    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    line-height: 1;
    color: var(--logo-primary);
  }

  .logo--inverse {
    color: var(--linen);
  }

  .logo__badge {
    display: inline-flex;
    flex-shrink: 0;
  }

  .logo--inverse .logo__badge {
    background-color: var(--linen);
    border-radius: var(--radius);
    padding: 0.32rem;
  }

  .logo__mark {
    width: var(--mark-size);
    height: var(--mark-size);
    overflow: hidden;
    flex-shrink: 0;
  }

  .logo__mark img {
    width: 100%;
    height: 100%;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: 0.26rem;
  }

  .logo__name {
    font-family: var(--font-body);
    font-size: 1.02rem;
    white-space: nowrap;
    font-weight: 400;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    line-height: 1;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 400;
    letter-spacing: 0.03em;
    line-height: 1;
    opacity: 0.92;
  }

  @media (max-width: 26rem) {
    .logo {
      --mark-size: 2.3rem;
      gap: 0.5rem;
    }

    .logo__name {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
    }

    .logo__tagline {
      font-size: 0.54rem;
    }
  }
</style>

<span class:list={['logo', `logo--${variant}`]}>
  <span class="logo__badge">
    <span class="logo__mark">
      <img src="/logo.png" alt="" width="512" height="512" loading="eager" decoding="async" />
    </span>
  </span>

  <span class="logo__text">
    <span class="logo__name">The Sorted Sequoia</span>
    <span class="logo__tagline">The art of everyday order</span>
  </span>
</span>
